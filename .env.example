# Frontend (Vercel)
# Оставьте пустым для локальной разработки с Vite proxy.
# На Vercel укажите URL бэкенда без слэша в конце:
# VITE_API_URL=https://prob-api.up.railway.app
VITE_API_URL=

# Backend
PORT=3001
JWT_SECRET=change-me-in-production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/prob?retryWrites=true&w=majority
# CORS: через запятую origin фронта на Vercel
CORS_ORIGIN=http://localhost:5173
