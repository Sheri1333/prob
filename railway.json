{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --prefix server"
  },
  "deploy": {
    "startCommand": "NODE_OPTIONS=--dns-result-order=ipv4first npm run start --prefix server",
    "restartPolicyType": "ON_FAILURE"
  }
}
